# SECRET 58 — AI Social Command Center
# Kopiere diese Datei nach .env und trage die gewünschten Werte ein.
# Die Anwendung startet auch, wenn optionale Variablen leer bleiben —
# nicht konfigurierte Integrationen werden im UI als "Nicht konfiguriert" angezeigt.

# --- Datenbank (erforderlich) -------------------------------------------------
# Standard: lokale SQLite-Datei, kein externer Server nötig.
DATABASE_URL="file:./dev.db"

# --- KI-Provider (für Content Brain / Script / Idea / Hook Engine) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ElevenLabs Voice Engine ---------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Social Platforms -----------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Weitere Integrationen -------------------------------------------------------
CANVA_API_KEY=
CAPCUT_API_KEY=

# --- Trend Engine (optional, sofern ein Anbieter verfügbar ist) -----------------
TREND_API_KEY=
TREND_API_PROVIDER=

# --- App -------------------------------------------------------------------------
NEXTAUTH_SECRET=

# --- Kauf-Freischaltung (Stripe) -------------------------------------------------
# Ohne diese Variablen bleibt die App komplett offen (kein Zugriffsschutz aktiv) —
# genau wie jede andere Integration hier: startfähig ohne Konfiguration.
#
# 1. STRIPE_SECRET_KEY / STRIPE_PRICE_ID setzen  -> /buy zeigt den echten Preis an
#    und der Kaufen-Button funktioniert (Stripe Checkout).
# 2. OWNER_ACCESS_KEY setzen (ein beliebiges, langes Geheimwort)
#    -> DAS sperrt die komplette Anwendung. Erst ab hier muss ein Kunde bezahlen,
#    um Zugriff zu bekommen. Solange diese Variable leer ist, bleibt die App offen.
# 3. STRIPE_WEBHOOK_SECRET setzen -> Stripe schaltet Käufer serverseitig sofort frei
#    (zusätzlich zur Freischaltung direkt nach dem Checkout-Redirect).
#
# Eintragen: lokal in dieser .env-Datei, live im Render-Dashboard unter
# "Environment" (genau wie ANTHROPIC_API_KEY, ELEVENLABS_API_KEY usw.).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Eigener Zugriffsschlüssel für den Betreiber (dich): sobald gesetzt, sperrt die
# App sich für alle außer Käufer — dein Browser bleibt über
# https://<deine-domain>/unlock?key=<OWNER_ACCESS_KEY> dauerhaft freigeschaltet.
OWNER_ACCESS_KEY=
