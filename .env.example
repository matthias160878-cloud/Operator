# SECRET 58 — AI Social Command Center
# Kopiere diese Datei nach .env und trage die gewünschten Werte ein.
# Die Anwendung startet auch, wenn optionale Variablen leer bleiben —
# nicht konfigurierte Integrationen werden im UI als "Nicht konfiguriert" angezeigt.

# --- Datenbank (erforderlich) -------------------------------------------------
# Echtes Postgres, lokal und in Produktion — keine SQLite-Datei mehr.
#
# Grund für die Umstellung: Render (und jeder andere Host mit flüchtigem
# Dateisystem) löscht eine SQLite-Datei bei jedem Deployment/Neustart ---
# damit wären Konten, Sitzungen, Workspaces, Lizenzen und der Replay-Schutz
# der Entitlement-Brücke (EntitlementRedemption, AboStatusEreignis) nach
# jedem Deployment weg, nicht nur leer. Das Schema (prisma/schema.prisma)
# nutzt keine SQLite-spezifischen Typen, die Umstellung war also rein ein
# Config-Wechsel.
#
# Lokale Entwicklung: eine lokale Postgres-Instanz nötig (z.B.
# `docker run --name secret58-operator-db -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:16`),
# dann:
DATABASE_URL="postgresql://postgres:dev@localhost:5432/secret58_operator"
# Produktion (Render-Postgres oder selbst gehostet, z.B. auf einem VPS):
# DATABASE_URL="postgresql://<user>:<passwort>@<host>:5432/<datenbank>?sslmode=require"
# Nach jedem Setzen/Ändern der Schema-Datei: `npm run db:push` ausführen
# (dieses Projekt nutzt `prisma db push`, keine Migrations-Historie),
# bevor die App startet.

# --- KI-Provider (für Content Brain / Script / Idea / Hook Engine) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ElevenLabs Voice Engine ---------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Social Platforms (echter OAuth-Verbinden-Flow unter /social-media) ---------
# Nach dem Eintragen hier erscheint auf der Social-Media-Seite ein echter
# "Verbinden"-Button für die jeweilige Plattform. In der Entwickler-Konsole
# jedes Anbieters muss zusätzlich folgende Redirect-/Callback-URL eingetragen
# werden (mit eurer tatsächlichen Domain statt <domain>):
#   https://<domain>/api/oauth/<PLATTFORM>/callback
#   z.B. https://secret58-command-center.onrender.com/api/oauth/YOUTUBE/callback
# TOKEN_ENCRYPTION_KEY (siehe unten) muss zusätzlich gesetzt sein, bevor ein
# Konto verbunden werden kann.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Verschlüsselt die Zugangstoken der oben verbundenen Social-Media-Konten,
# bevor sie in der Datenbank gespeichert werden. Beliebige, ausreichend lange
# Zeichenkette (z.B. per `openssl rand -hex 32` erzeugen). Ohne diese Variable
# bleibt "Verbinden" für alle Plattformen gesperrt (Sicherheitsmaßnahme, kein
# unverschlüsseltes Speichern von Zugangstoken).
TOKEN_ENCRYPTION_KEY=

# --- Weitere Integrationen -------------------------------------------------------
CANVA_API_KEY=
CAPCUT_API_KEY=

# --- Trend Engine (optional, sofern ein Anbieter verfügbar ist) -----------------
TREND_API_KEY=
TREND_API_PROVIDER=

# --- App -------------------------------------------------------------------------
NEXTAUTH_SECRET=

# --- Kauf-Freischaltung (Stripe) -------------------------------------------------
# Ohne diese Variablen bleibt die App komplett offen (kein Zugriffsschutz aktiv) —
# genau wie jede andere Integration hier: startfähig ohne Konfiguration.
#
# Zwei Pakete, zwei Preise: SECRET 58 Pro (590 € einmalig) und SECRET 58 Maxi
# (797 € einmalig) — zentrale Definition inkl. monatlicher Kontingente in
# src/lib/packages.ts. Beide schalten denselben vollen Funktionsumfang frei,
# unterscheiden sich nur in den monatlichen Kontingenten (Ideen/Videos/
# Sprachausgaben).
#
# Produkte/Preise in Stripe anlegen: entweder manuell im Dashboard (je ein
# Produkt mit einmaliger Zahlung, "one time", zu genau diesem Preis), oder
# automatisiert mit:
#
#   npm run stripe:setup-products
#
# Das Skript (scripts/setup-stripe-products.ts) liest STRIPE_SECRET_KEY aus
# genau dieser Datei, legt beide Produkte/Preise an (sicher wiederholt
# ausführbar — legt bei erneutem Lauf keine Duplikate an) und gibt die
# Price-IDs zum Eintragen unten aus. Secret Key dafür ausschließlich hier in
# .env eintragen, niemals im Chat oder als Kommandozeilen-Argument.
#
# 1. STRIPE_SECRET_KEY + STRIPE_PRICE_ID_PRO/_MAXI setzen -> /buy zeigt den
#    echten Preis an und der Kaufen-Button funktioniert (Stripe Checkout).
# 2. OWNER_ACCESS_KEY setzen (ein beliebiges, langes Geheimwort)
#    -> DAS sperrt die komplette Anwendung. Erst ab hier muss ein Kunde bezahlen,
#    um Zugriff zu bekommen, UND greifen die monatlichen Paket-Kontingente
#    (lib/quota.ts). Solange diese Variable leer ist, bleibt die App offen.
# 3. STRIPE_WEBHOOK_SECRET setzen -> Stripe schaltet Käufer serverseitig sofort frei
#    (zusätzlich zur Freischaltung direkt nach dem Checkout-Redirect).
#
# Eintragen: lokal in dieser .env-Datei, live im Render-Dashboard unter
# "Environment" (genau wie ANTHROPIC_API_KEY, ELEVENLABS_API_KEY usw.).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAXI=
STRIPE_WEBHOOK_SECRET=
# Optional: Einrichtungsservice (299 € einmalig, siehe src/lib/pricing.ts) als
# zweites Stripe-Produkt anlegen und dessen Price-ID hier eintragen. Dann kann
# die Kundin/der Kunde ihn auf /buy per Häkchen zum Komplettpaket dazubuchen.
STRIPE_SETUP_PRICE_ID=

# Eigener Zugriffsschlüssel für den Betreiber (dich): sobald gesetzt, sperrt die
# App sich für alle außer Käufer — dein Browser bleibt über
# https://<deine-domain>/unlock?key=<OWNER_ACCESS_KEY> dauerhaft freigeschaltet.
OWNER_ACCESS_KEY=

# Entitlement-Token-Brücke zu secret58-web ("der Zentrale"): wer dort mit
# aktivem Pro/Maxi angemeldet "Social Media AI" öffnet, landet über
# /entitlement/einloesen hier und bekommt automatisch Zugriff — ohne diese
# Variable lehnt die Route jedes Token ab. MUSS exakt derselbe Wert sein wie
# ENTITLEMENT_GEHEIMNIS dort — sonst scheitert die Signaturprüfung immer.
ENTITLEMENT_SECRET=

# Adresse der Zentrale (secret58-web) — Pro/Maxi gibt es NUR dort zu kaufen
# (Abo, monatlich oder jährlich), nie hier. /buy verlinkt mit dieser
# Variable auf die dortige Preisseite statt einen eigenen Checkout zu
# starten. Ohne diese Variable zeigt /buy nur einen Hinweis, keinen Link.
ZENTRALE_URL=
