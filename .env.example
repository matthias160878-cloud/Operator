# SECRET 58 — AI Social Command Center
# Kopiere diese Datei nach .env und trage die gewünschten Werte ein.
# Die Anwendung startet auch, wenn optionale Variablen leer bleiben —
# nicht konfigurierte Integrationen werden im UI als "Nicht konfiguriert" angezeigt.

# --- Datenbank (erforderlich) -------------------------------------------------
# Standard: lokale SQLite-Datei, kein externer Server nötig.
DATABASE_URL="file:./dev.db"

# --- KI-Provider (für Content Brain / Script / Idea / Hook Engine) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ElevenLabs Voice Engine ---------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Social Platforms (echter OAuth-Verbinden-Flow unter /social-media) ---------
# Nach dem Eintragen hier erscheint auf der Social-Media-Seite ein echter
# "Verbinden"-Button für die jeweilige Plattform. In der Entwickler-Konsole
# jedes Anbieters muss zusätzlich folgende Redirect-/Callback-URL eingetragen
# werden (mit eurer tatsächlichen Domain statt <domain>):
#   https://<domain>/api/oauth/<PLATTFORM>/callback
#   z.B. https://secret58-command-center.onrender.com/api/oauth/YOUTUBE/callback
# TOKEN_ENCRYPTION_KEY (siehe unten) muss zusätzlich gesetzt sein, bevor ein
# Konto verbunden werden kann.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Verschlüsselt die Zugangstoken der oben verbundenen Social-Media-Konten,
# bevor sie in der Datenbank gespeichert werden. Beliebige, ausreichend lange
# Zeichenkette (z.B. per `openssl rand -hex 32` erzeugen). Ohne diese Variable
# bleibt "Verbinden" für alle Plattformen gesperrt (Sicherheitsmaßnahme, kein
# unverschlüsseltes Speichern von Zugangstoken).
TOKEN_ENCRYPTION_KEY=

# --- Posteingang: Zusatz-Apps für Kommentare (TikTok, LinkedIn) ---------------
# TikTok: Developer-App im TikTok-for-Business-Portal (Accounts API) mit den
# Berechtigungen video.list, comment.list, comment.list.manage.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
# Direktnachrichten über die TikTok Business Messaging API — erst nach TikToks
# Zugangs-/Datenschutzprüfung einschalten. Die Messaging-Berechtigungen aus der
# App-Konfiguration in TIKTOK_BUSINESS_SCOPE ergänzen (kommagetrennt) und den
# Posteingang danach neu verbinden.
TIKTOK_BUSINESS_MESSAGING=
TIKTOK_BUSINESS_SCOPE=
# LinkedIn: eigene App, auf der nur die Community Management API freigegeben ist.
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# Optional: abweichende Scopes/Version, falls LinkedIn der App andere freigibt.
LINKEDIN_PAGE_SCOPE=
LINKEDIN_API_VERSION=

# --- Weitere Integrationen -------------------------------------------------------
CANVA_API_KEY=
CAPCUT_API_KEY=

# --- SEO-Agent / Website-Tools (MCP-Server) --------------------------------------
# Optional: Google PageSpeed Insights API-Key für stabile Lighthouse-Analysen
# (ohne Key funktioniert es mit stark begrenztem Kontingent).
PAGESPEED_API_KEY=
# Nur für lokale Tests: erlaubt das Abrufen von localhost/privaten IPs.
# In Produktion leer lassen (Schutz vor Abruf interner Dienste).
WEB_FETCH_ALLOW_PRIVATE=

# --- Externe API (/api/v1) für Zapier, eigene Website, Skripte ------------------
# Leer = externe API ist aus. Mehrere Schlüssel kommagetrennt; Schlüssel z. B.
# mit `openssl rand -hex 32` erzeugen und wie ein Passwort behandeln.
PUBLIC_API_KEYS=
# Anfragen pro Minute und Schlüssel (Standard 30).
PUBLIC_API_RATE_LIMIT=
# Erlaubte Browser-Origins für CORS (kommagetrennt oder *). Leer = kein CORS.
PUBLIC_API_CORS_ORIGINS=

# --- Trend Engine (optional, sofern ein Anbieter verfügbar ist) -----------------
TREND_API_KEY=
TREND_API_PROVIDER=

# --- App -------------------------------------------------------------------------
NEXTAUTH_SECRET=

# --- Kauf-Freischaltung (Stripe) -------------------------------------------------
# Ohne diese Variablen bleibt die App komplett offen (kein Zugriffsschutz aktiv) —
# genau wie jede andere Integration hier: startfähig ohne Konfiguration.
#
# Ein Paket, ein Preis: SECRET 58 wird als einzelnes Komplettpaket verkauft
# ("Social Media KI"), keine Staffelung. Empfohlener Preis: 797 € einmalig
# (siehe src/lib/pricing.ts) — im Stripe-Dashboard ein Produkt mit genau
# diesem Preis (einmalige Zahlung, "one time") anlegen und dessen Price-ID
# unten bei STRIPE_PRICE_ID eintragen.
#
# 1. STRIPE_SECRET_KEY / STRIPE_PRICE_ID setzen  -> /buy zeigt den echten Preis an
#    und der Kaufen-Button funktioniert (Stripe Checkout).
# 2. OWNER_ACCESS_KEY setzen (ein beliebiges, langes Geheimwort)
#    -> DAS sperrt die komplette Anwendung. Erst ab hier muss ein Kunde bezahlen,
#    um Zugriff zu bekommen. Solange diese Variable leer ist, bleibt die App offen.
# 3. STRIPE_WEBHOOK_SECRET setzen -> Stripe schaltet Käufer serverseitig sofort frei
#    (zusätzlich zur Freischaltung direkt nach dem Checkout-Redirect).
#
# Eintragen: lokal in dieser .env-Datei, live im Render-Dashboard unter
# "Environment" (genau wie ANTHROPIC_API_KEY, ELEVENLABS_API_KEY usw.).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Eigener Zugriffsschlüssel für den Betreiber (dich): sobald gesetzt, sperrt die
# App sich für alle außer Käufer — dein Browser bleibt über
# https://<deine-domain>/unlock?key=<OWNER_ACCESS_KEY> dauerhaft freigeschaltet.
OWNER_ACCESS_KEY=
