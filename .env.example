# SECRET 58 — AI Social Command Center
# Kopiere diese Datei nach .env und trage die gewünschten Werte ein.
# Die Anwendung startet auch, wenn optionale Variablen leer bleiben —
# nicht konfigurierte Integrationen werden im UI als "Nicht konfiguriert" angezeigt.

# --- Datenbank (erforderlich) -------------------------------------------------
# Standard: lokale SQLite-Datei, kein externer Server nötig.
DATABASE_URL="file:./dev.db"

# --- KI-Provider (für Content Brain / Script / Idea / Hook Engine) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ElevenLabs Voice Engine ---------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Social Platforms (echter OAuth-Verbinden-Flow unter /social-media) ---------
# Nach dem Eintragen hier erscheint auf der Social-Media-Seite ein echter
# "Verbinden"-Button für die jeweilige Plattform. In der Entwickler-Konsole
# jedes Anbieters muss zusätzlich folgende Redirect-/Callback-URL eingetragen
# werden (mit eurer tatsächlichen Domain statt <domain>):
#   https://<domain>/api/oauth/<PLATTFORM>/callback
#   z.B. https://secret58-command-center.onrender.com/api/oauth/YOUTUBE/callback
# TOKEN_ENCRYPTION_KEY (siehe unten) muss zusätzlich gesetzt sein, bevor ein
# Konto verbunden werden kann.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Verschlüsselt die Zugangstoken der oben verbundenen Social-Media-Konten,
# bevor sie in der Datenbank gespeichert werden. Beliebige, ausreichend lange
# Zeichenkette (z.B. per `openssl rand -hex 32` erzeugen). Ohne diese Variable
# bleibt "Verbinden" für alle Plattformen gesperrt (Sicherheitsmaßnahme, kein
# unverschlüsseltes Speichern von Zugangstoken).
TOKEN_ENCRYPTION_KEY=

# --- Weitere Integrationen -------------------------------------------------------
CANVA_API_KEY=
CAPCUT_API_KEY=

# --- Trend Engine (optional, sofern ein Anbieter verfügbar ist) -----------------
TREND_API_KEY=
TREND_API_PROVIDER=

# --- App -------------------------------------------------------------------------
NEXTAUTH_SECRET=

# --- Anmeldung & Betreiber -------------------------------------------------------
# Einmaliger Einrichtungsschlüssel für das Betreiberkonto (/setup). Mindestens 32
# zufällige Zeichen, z. B.:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nach der Einrichtung ist /setup gesperrt; der Wert kann dann entfernt werden.
OPERATOR_SETUP_TOKEN=
# Öffentliche Adresse der Anwendung (für Einbindungscodes), z. B. https://app.secret58.com
PUBLIC_APP_URL=
# Ablage privater Kundendateien (Standard: ./storage/media) — NICHT unter public/.
MEDIA_STORAGE_DIR=
# Schlüssel für kurzlebige, signierte Medien-Links (Instagram/TikTok holen Videos per URL).
# Ohne Wert wird TOKEN_ENCRYPTION_KEY verwendet.
MEDIA_URL_SECRET=
# Anzahl eigener Reverse Proxys vor der App (Caddy = 1, direkt erreichbar = 0).
# Bestimmt, welcher X-Forwarded-For-Eintrag als Client-Adresse für Ratenbegrenzung gilt.
TRUSTED_PROXY_HOPS=1

# --- Impressum (§ 5 DDG) und Rechtstexte ----------------------------------------
# Ohne Name, Anschrift, E-Mail sowie AGB- und Datenschutz-Link bleibt der Verkauf gesperrt.
# Mehrzeilige Anschrift mit " | " trennen. Optionale Felder leer lassen, wenn nicht zutreffend.
IMPRESSUM_NAME=
IMPRESSUM_FIRMA=
IMPRESSUM_ANSCHRIFT=
IMPRESSUM_EMAIL=
IMPRESSUM_TELEFON=
IMPRESSUM_UST_ID=
IMPRESSUM_REGISTER=
IMPRESSUM_AUFSICHT=
IMPRESSUM_VERANTWORTLICH=
IMPRESSUM_STREITBEILEGUNG=
AGB_URL=
DATENSCHUTZ_URL=

# --- Pakete Pro / Maxi (zentrale Definition: src/lib/plans.ts) -------------------
# Betrag, Währung und Abrechnungsintervall kommen aus dem jeweiligen Stripe-Preis:
# ein wiederkehrender Preis ergibt ein Abo, ein einmaliger eine Einmalzahlung.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAXI=
# Jahresabo (12 × Monatspreis minus 15 %): Pro 6.018,00 €, Maxi 8.129,40 € netto/Jahr
STRIPE_PRICE_ID_PRO_YEAR=
STRIPE_PRICE_ID_MAXI_YEAR=
# Erst auf "true" setzen, wenn Preise, Leistungen, Kontingente und Abrechnungs-
# zeitraum verbindlich bestätigt sind. Vorher verweigert der Checkout den Verkauf.
PACKAGE_TERMS_CONFIRMED=false

# --- Stripe (Betreiber-Konto) ----------------------------------------------------
# Test: sk_test_... / Live: sk_live_... (niemals ins Repository!)
STRIPE_SECRET_KEY=
# Signaturschlüssel des Webhook-Endpunkts https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Signaturschlüssel des Connect-Endpunkts https://<domain>/api/stripe/connect-webhook
# ("Events from: Connected accounts"). Ohne ihn bleibt der Verkaufsbereich der Kunden aus.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- KI-Kosten- und Zeitgrenzen (optional) -----------------------------------------
# AI_TIMEOUT_MS=60000
# AI_MAX_TOKENS_CAP=2048
# ANTHROPIC_BASE_URL=        # nur für Proxy/Tests; leer = api.anthropic.com

# --- Nur für Tests / lokale Vorschau — in Produktion LEER lassen ------------------
# STRIPE_API_HOST=            # lokale Stripe-Attrappe der Tests
# ALLOW_PRIVATE_SITE_FETCH=   # erlaubt Domainprüfung gegen localhost
# SEED_DEMO_DATA=             # "true" legt beim Seed Demo-Daten an

# --- Composio (Konto verbinden + lesender Zugriffstest; NICHT zum Veröffentlichen) ---
# Server-Schlüssel nur in der Server-Umgebung (Render → Environment), nie im Repo/Chat.
COMPOSIO_API_KEY=
# Auth-Config-IDs (ac_…) aus dem Composio-Dashboard, je Plattform eine.
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_FACEBOOK=
COMPOSIO_AUTH_CONFIG_LINKEDIN=
COMPOSIO_AUTH_CONFIG_YOUTUBE=
# Präfix der Kundenkennung bei Composio (Test und Live getrennt halten, z. B. s58test / s58live).
COMPOSIO_USER_PREFIX=s58
# Optional: abweichendes Lese-Werkzeug je Plattform, z. B. COMPOSIO_READ_TOOL_LINKEDIN=LINKEDIN_GET_MY_INFO

# --- Versand zum Termin ---
# inline = Worker läuft im Web-Prozess mit; leer lassen, wenn ein eigener Prozess (npm run worker) läuft.
PUBLISH_WORKER=
PUBLISH_WORKER_INTERVAL_MS=30000

# --- Startseite (Zentrale) ---
# KI im öffentlichen Chat und in der Skill-Anfrage (kostet je Besucher): nur mit true.
WEBSITE_KI=
WEBSITE_KI_TAGESLIMIT=200
# Optional: Arbeitsbereich, in dessen Posteingang Kontakt- und Terminanfragen landen (sonst erstes Betreiberkonto).
SECRET58_OPERATOR_WORKSPACE_ID=

# Newsletter (Double-Opt-in über Resend). Ohne beide Werte bleibt das Formular
# ausgeblendet. Absenderdomain muss bei Resend bestätigt sein. Nur serverseitig setzen.
RESEND_API_KEY=
EMAIL_FROM=

# Einmalig: bereits registriertes Konto beim Serverstart zum Betreiber machen
# (nur solange noch kein Betreiber existiert; danach wieder entfernen).
OPERATOR_PROMOTE_EMAIL=
