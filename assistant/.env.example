# Kopieren nach .env und ausfüllen (oder als Umgebungsvariablen setzen).
ANTHROPIC_API_KEY=sk-ant-...

# Optional - Standardwerte siehe src/heim_assistant/config.py
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_SYSTEM_PROMPT=...
# ASSISTANT_WORKSPACE=/pfad/zu/deinem/arbeitsverzeichnis

# Sprach-Erweiterung (optional, siehe README.md "Sprach-Erweiterung einrichten")
# STT_MODEL_SIZE=small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_LANGUAGE=de
# SHERPA_ONNX_TTS_MODEL=/pfad/zu/modell.onnx
# SHERPA_ONNX_TTS_TOKENS=/pfad/zu/tokens.txt
# SHERPA_ONNX_TTS_LEXICON=/pfad/zu/lexicon.txt
# SHERPA_ONNX_TTS_DATA_DIR=/pfad/zu/espeak-ng-data
# ASSISTANT_MIC_SAMPLE_RATE=16000
# ASSISTANT_RECORD_SECONDS=5
