// SECRET 58 — AI Social Command Center
// Datenmodell gemäß Master-Prompt Abschnitt 24.
// SQLite als Standard-Engine, damit die App ohne externe Datenbank startfähig bleibt.
// Für Produktion: DATABASE_URL auf Postgres/MySQL umstellen (provider anpassen).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum IdeaStatus {
  NEW
  IN_PROGRESS
  USED
  ARCHIVED
}

enum IdeaSource {
  MANUAL
  IDEA_AGENT
  TREND_AGENT
  REPURPOSE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  BLOG
  NEWSLETTER
}

enum MediaType {
  AUDIO
  VIDEO
  IMAGE
  THUMBNAIL
  SUBTITLE
}

enum AccountStatus {
  CONNECTED
  NOT_CONFIGURED
  ERROR
}

enum RevenueType {
  AD_REVENUE
  SPONSORSHIP
  AFFILIATE
  DONATION
  OTHER
}

enum RevenueStatus {
  PENDING
  RECEIVED
}

enum RevenueOrigin {
  MANUAL
  YOUTUBE_API
}

enum LicenseStatus {
  PENDING
  ACTIVE
  REFUNDED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  DRAFTED
  APPROVED
  SENT
  FAILED
}

enum AgentStatus {
  IDLE
  RUNNING
  WAITING
  SUCCESS
  ERROR
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  brand            Brand?
  campaigns        Campaign[]
  contentIdeas     ContentIdea[]
  contentItems     ContentItem[]
  voices           Voice[]
  mediaAssets      MediaAsset[]
  platformAccounts PlatformAccount[]
  agentRuns        AgentRun[]
  integrations     IntegrationStatus[]
  settings         Setting[]
  auditLogs        AuditLog[]
  revenueEntries   RevenueEntry[]
  conversations    Conversation[]
  licenses         License[]

  @@map("workspaces")
}

model User {
  id                       String    @id @default(cuid())
  workspaceId              String
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email                    String    @unique
  name                     String
  passwordHash             String
  role                     Role      @default(OWNER)
  createdAt                DateTime  @default(now())
  /// "kundenschluessel" der Zentrale (secret58-web) --- gesetzt, wenn dieses
  /// Konto per Entitlement-Token entstand/verknüpft wurde, siehe
  /// src/lib/entitlement.ts. Nie die E-Mail-Adresse der Zentrale.
  externalKundenschluessel String?   @unique

  auditLogs AuditLog[]
  sessions  Session[]
  licenses  License[]

  @@map("users")
}

// Server-seitige Sessions (Abschnitt "Authentifizierung" — auf Nutzerwunsch
// ergänzt: Abschnitt 2 des Auftrags verlangt, dass jede Berechtigung aus der
// authentifizierten Sitzung abgeleitet wird, nie aus einer vom Client
// gelieferten Workspace-ID). Es wird nur ein SHA-256-Hash des Session-Tokens
// gespeichert, nie das Token selbst — ein DB-Leak allein reicht nicht, um
// eine Sitzung zu übernehmen. Serverseitig widerrufbar (Zeile löschen/
// Ablaufdatum), im Gegensatz zu einem reinen JWT.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Brand {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String    @default("")
  targetAudience String    @default("")
  industry       String    @default("")
  language       String    @default("Deutsch")
  tonality       String    @default("Professionell & Inspirierend")
  humor          String    @default("Dezent")
  formality      String    @default("Neutral")
  preferredWords String    @default("[]") // JSON string[]
  forbiddenWords String    @default("[]") // JSON string[]
  preferredCtas  String    @default("[]") // JSON string[]
  brandValues    String    @default("[]") // JSON string[]
  topics         String    @default("[]") // JSON string[]
  colors         String    @default("[]") // JSON string[]
  fonts          String    @default("[]") // JSON string[]
  logoUrl        String?
  visualRules    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("brands")
}

model Campaign {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  goal           String    @default("")
  targetAudience String    @default("")
  platforms      String    @default("[]") // JSON Platform[]
  language       String    @default("Deutsch")
  status         String    @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | ARCHIVED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contentItems   ContentItem[]
  ideas          ContentIdea[]
  revenueEntries RevenueEntry[]

  @@map("campaigns")
}

model ContentIdea {
  id               String     @id @default(cuid())
  workspaceId      String
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title            String
  hook             String     @default("")
  targetAudience   String     @default("")
  platform         String     @default("")
  format           String     @default("")
  goal             String     @default("")
  priority         Priority   @default(MEDIUM)
  estimatedMinutes Int        @default(30)
  status           IdeaStatus @default(NEW)
  source           IdeaSource @default(MANUAL)
  createdAt        DateTime   @default(now())

  contentItems ContentItem[]

  @@map("content_ideas")
}

model ContentItem {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ideaId         String?
  idea           ContentIdea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  title          String
  platform       Platform
  format         String        @default("")
  status         ContentStatus @default(DRAFT)
  hook           String        @default("")
  script         String        @default("")
  caption        String        @default("")
  hashtags       String        @default("[]") // JSON string[]
  keywords       String        @default("[]") // JSON string[]
  language       String        @default("Deutsch")
  thumbnailIdea  String        @default("")
  rejectedReason String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  scripts     Script[]
  mediaAssets MediaAsset[]
  analytics   Analytics[]

  @@map("content_items")
}

model Script {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  variantLabel  String      @default("A")
  hook          String      @default("")
  problem       String      @default("")
  value         String      @default("")
  example       String      @default("")
  payoff        String      @default("")
  cta           String      @default("")
  createdAt     DateTime    @default(now())

  @@map("scripts")
}

model Voice {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  providerVoiceId String
  language        String    @default("de")
  style           String    @default("")
  description     String    @default("")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("voices")
}

model MediaAsset {
  id              String       @id @default(cuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItemId   String?
  contentItem     ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  type            MediaType
  url             String
  provider        String       @default("local")
  format          String       @default("")
  durationSeconds Int?
  createdAt       DateTime     @default(now())

  @@map("media_assets")
}

model PlatformAccount {
  id                String        @id @default(cuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          Platform
  accountName       String        @default("")
  status            AccountStatus @default(NOT_CONFIGURED)
  lastPublishedAt   DateTime?
  lastError         String?
  createdAt         DateTime      @default(now())
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  externalAccountId String?

  @@unique([workspaceId, platform])
  @@map("platform_accounts")
}

model Analytics {
  id               String      @id @default(cuid())
  contentItemId    String
  contentItem      ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  platform         Platform
  views            Int         @default(0)
  likes            Int         @default(0)
  comments         Int         @default(0)
  shares           Int         @default(0)
  saves            Int         @default(0)
  engagementRate   Float       @default(0)
  watchTimeSeconds Int         @default(0)
  ctr              Float?
  recordedAt       DateTime    @default(now())

  @@map("analytics")
}

model AgentRun {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentKey    String
  agentName   String
  task        String
  status      AgentStatus @default(IDLE)
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  result      String?
  error       String?

  @@map("agent_runs")
}

model IntegrationStatus {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String
  status        AccountStatus @default(NOT_CONFIGURED)
  lastCheckedAt DateTime      @default(now())
  lastError     String?

  @@unique([workspaceId, key])
  @@map("integration_status")
}

model Setting {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  value       String    @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@map("settings")
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  detail      String    @default("")
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

// Einnahmen (Abschnitt "Revenue" — nicht Teil des ursprünglichen Master-Prompts,
// auf Nutzerwunsch ergänzt). Plattformen geben Einnahmen überwiegend NICHT über
// eine öffentliche API heraus (TikTok/Meta gar nicht, YouTube nur eingeschränkt
// über die YouTube-Analytics-API mit Partnerprogramm-Zugang). Einträge sind
// deshalb primär manuell erfasst (`origin: MANUAL`); `origin: YOUTUBE_API` ist
// für eine spätere echte Anbindung vorgesehen, aber noch nicht implementiert —
// siehe `lib/integrations/registry.ts` (Status bleibt NOT_CONFIGURED).
model RevenueEntry {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform    Platform?
  type        RevenueType   @default(OTHER)
  status      RevenueStatus @default(RECEIVED)
  origin      RevenueOrigin @default(MANUAL)
  source      String        @default("")
  amount      Float
  currency    String        @default("EUR")
  note        String        @default("")
  recordedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("revenue_entries")
}

// Posteingang (auf Nutzerwunsch ergänzt). Es gibt für keine Plattform eine
// echte OAuth-Verbindung in dieser App — Konversationen werden deshalb
// manuell simuliert/importiert statt live von den Plattformen abgerufen.
// Das MessageAgent-Antwortdraft-Feature funktioniert echt (KI oder
// Template-Fallback); das tatsächliche Senden an eine reale Plattform ist
// als Adapter vorbereitet, meldet aber ehrlich NOT_CONFIGURED, solange kein
// echter Zugang existiert — siehe `lib/agents/messageAgent.ts`.
model Conversation {
  id                String             @id @default(cuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          Platform
  participantName   String
  participantHandle String             @default("")
  status            ConversationStatus @default(OPEN)
  lastMessageAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  status         MessageStatus    @default(RECEIVED)
  error          String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  @@map("messages")
}

// Lizenzierung (auf Nutzerwunsch ergänzt). Seit Einführung echter Nutzerkonten
// (Abschnitt "Authentifizierung") ist jede Lizenz an den eingeloggten Nutzer
// gebunden, der den Checkout gestartet hat (`userId`/`workspaceId`, aus der
// Server-Session gesetzt, nie aus Client-Daten) — das schaltet gezielt genau
// dessen Workspace frei, nicht mehr eine global geteilte Instanz. Für vor der
// Umstellung entstandene Lizenzen bleiben beide Felder leer (`null`); der
// anonyme Freischalt-Cookie (`unlockToken`) bleibt als Fallback bestehen.
// Der Betreiber-Zugang läuft separat über OWNER_ACCESS_KEY (siehe proxy.ts)
// und braucht keinen License-Datensatz.
model License {
  id                      String        @id @default(cuid())
  unlockToken             String        @unique
  status                  LicenseStatus @default(PENDING)
  /// "pro" | "maxi" — siehe src/lib/packages.ts. Nullable für Alt-Lizenzen
  /// aus der Zeit vor dem Zwei-Pakete-Modell.
  packageId               String?
  /// "stripe" (hier bezahlt, Normalfall bisher) oder "zentrale" (Zugriff
  /// über das Entitlement-Token von secret58-web übernommen, kein eigener
  /// Kauf hier). Das Betreiber-Dashboard zählt nur "stripe" als Umsatz ---
  /// sonst würde ein unentgeltlich übernommener Zugriff wie ein zweiter
  /// Verkauf aussehen, siehe src/app/operator/page.tsx.
  origin                  String        @default("stripe")
  customerEmail           String        @default("")
  stripeCheckoutSessionId String        @unique
  stripeCustomerId        String        @default("")
  stripePaymentIntentId   String        @default("")
  amountTotal             Int           @default(0)
  currency                String        @default("eur")
  userId                  String?
  user                    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId             String?
  workspace               Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([workspaceId])
  @@map("licenses")
}

/// Replay-Schutz für Entitlement-Tokens aus der Zentrale (secret58-web):
/// jedes `jti` wird hier genau einmal eingetragen, bevor die Einlösung
/// fortfährt --- ein zweiter Versuch mit demselben Token (z.B. ein
/// abgefangener Link) scheitert dann an diesem eindeutigen Index, nicht an
/// einer zeitlichen Vermutung. Einträge veralten mit der Token-Gültigkeit
/// (siehe src/lib/entitlement.ts) und müssen nicht aufgeräumt werden, um
/// korrekt zu bleiben --- nur um die Tabelle klein zu halten.
model EntitlementRedemption {
  id         String   @id @default(cuid())
  jti        String   @unique
  redeemedAt DateTime @default(now())

  @@map("entitlement_redemptions")
}
