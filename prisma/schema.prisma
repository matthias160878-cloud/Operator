// SECRET 58 — AI Social Command Center
// Datenmodell gemäß Master-Prompt Abschnitt 24.
// SQLite als Standard-Engine, damit die App ohne externe Datenbank startfähig bleibt.
// Für Produktion: DATABASE_URL auf Postgres/MySQL umstellen (provider anpassen).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum IdeaStatus {
  NEW
  IN_PROGRESS
  USED
  ARCHIVED
}

enum IdeaSource {
  MANUAL
  IDEA_AGENT
  TREND_AGENT
  REPURPOSE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  LINKEDIN
  FACEBOOK
  BLOG
  NEWSLETTER
  /// Kontaktformular der eigenen Webseite (Startseite der Zentrale) — nur Posteingang
  WEBSITE
}

enum MediaType {
  AUDIO
  VIDEO
  IMAGE
  THUMBNAIL
  SUBTITLE
}

enum AccountStatus {
  CONNECTED
  NOT_CONFIGURED
  ERROR
}

enum RevenueType {
  AD_REVENUE
  SPONSORSHIP
  AFFILIATE
  DONATION
  OTHER
}

enum RevenueStatus {
  PENDING
  RECEIVED
}

enum RevenueOrigin {
  MANUAL
  YOUTUBE_API
}

enum LicenseStatus {
  PENDING
  ACTIVE
  REFUNDED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  DRAFTED
  APPROVED
  SENT
  FAILED
}

enum AgentStatus {
  IDLE
  RUNNING
  WAITING
  SUCCESS
  ERROR
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  brand               Brand?
  campaigns           Campaign[]
  contentIdeas        ContentIdea[]
  contentItems        ContentItem[]
  voices              Voice[]
  mediaAssets         MediaAsset[]
  platformAccounts    PlatformAccount[]
  agentRuns           AgentRun[]
  integrations        IntegrationStatus[]
  settings            Setting[]
  auditLogs           AuditLog[]
  revenueEntries      RevenueEntry[]
  conversations       Conversation[]
  plan                WorkspacePlan?
  usageCounters       UsageCounter[]
  checkouts           PlanCheckout[]
  merchantAccount     MerchantAccount?
  merchantProducts    MerchantProduct[]
  sellerProfile       SellerProfile?
  customerSales       CustomerSale[]
  websites            WebsiteConnection[]
  composioConnections ComposioConnection[]
  publishJobs         PublishJob[]
  pilotInquiries      PilotInquiry[]
  pilotEvents         PilotEvent[]
  pilotInterviews     PilotInterview[]
  pilotConfig         PilotConfig?
  kundenDateien       KundenDatei[]
  kundenLinks         KundenLink[]
  dateiFreigaben      DateiFreigabe[]

  @@map("workspaces")
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String    @unique
  name         String
  role         Role      @default(EDITOR)
  createdAt    DateTime  @default(now())
  /// scrypt-Hash (Format: scrypt$N$r$p$salt$hash). Null = Konto ohne Passwort (Altbestand/Demo).
  passwordHash String?
  /// Betreiberkonto (Umsatz-/Betriebsansicht). Wird nur über den geschützten
  /// Einrichtungsablauf (/setup + OPERATOR_SETUP_TOKEN) gesetzt, nie per Formular.
  isOperator   Boolean   @default(false)

  auditLogs AuditLog[]
  sessions  Session[]

  @@map("users")
}

model Brand {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String    @default("")
  targetAudience String    @default("")
  industry       String    @default("")
  language       String    @default("Deutsch")
  tonality       String    @default("Professionell & Inspirierend")
  humor          String    @default("Dezent")
  formality      String    @default("Neutral")
  preferredWords String    @default("[]") // JSON string[]
  forbiddenWords String    @default("[]") // JSON string[]
  preferredCtas  String    @default("[]") // JSON string[]
  brandValues    String    @default("[]") // JSON string[]
  topics         String    @default("[]") // JSON string[]
  colors         String    @default("[]") // JSON string[]
  fonts          String    @default("[]") // JSON string[]
  logoUrl        String?
  visualRules    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("brands")
}

model Campaign {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  goal           String    @default("")
  targetAudience String    @default("")
  platforms      String    @default("[]") // JSON Platform[]
  language       String    @default("Deutsch")
  status         String    @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | ARCHIVED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contentItems   ContentItem[]
  ideas          ContentIdea[]
  revenueEntries RevenueEntry[]

  @@map("campaigns")
}

model ContentIdea {
  id               String     @id @default(cuid())
  workspaceId      String
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title            String
  hook             String     @default("")
  targetAudience   String     @default("")
  platform         String     @default("")
  format           String     @default("")
  goal             String     @default("")
  priority         Priority   @default(MEDIUM)
  estimatedMinutes Int        @default(30)
  status           IdeaStatus @default(NEW)
  source           IdeaSource @default(MANUAL)
  createdAt        DateTime   @default(now())

  contentItems ContentItem[]

  @@map("content_ideas")
}

model ContentItem {
  id                  String        @id @default(cuid())
  workspaceId         String
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ideaId              String?
  idea                ContentIdea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  title               String
  platform            Platform
  format              String        @default("")
  status              ContentStatus @default(DRAFT)
  hook                String        @default("")
  script              String        @default("")
  caption             String        @default("")
  hashtags            String        @default("[]") // JSON string[]
  keywords            String        @default("[]") // JSON string[]
  language            String        @default("Deutsch")
  thumbnailIdea       String        @default("")
  rejectedReason      String?
  scheduledAt         DateTime?
  publishedAt         DateTime?
  /// Sperre gegen parallelen Doppelversand (gesetzt, solange veröffentlicht wird).
  publishingStartedAt DateTime?
  publishJobs         PublishJob[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  scripts     Script[]
  mediaAssets MediaAsset[]
  analytics   Analytics[]

  @@map("content_items")
}

model Script {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  variantLabel  String      @default("A")
  hook          String      @default("")
  problem       String      @default("")
  value         String      @default("")
  example       String      @default("")
  payoff        String      @default("")
  cta           String      @default("")
  createdAt     DateTime    @default(now())

  @@map("scripts")
}

model Voice {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  providerVoiceId String
  language        String    @default("de")
  style           String    @default("")
  description     String    @default("")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("voices")
}

model MediaAsset {
  id              String       @id @default(cuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItemId   String?
  contentItem     ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  type            MediaType
  url             String
  provider        String       @default("local")
  format          String       @default("")
  durationSeconds Int?
  createdAt       DateTime     @default(now())

  @@map("media_assets")
}

model PlatformAccount {
  id                String        @id @default(cuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          Platform
  accountName       String        @default("")
  status            AccountStatus @default(NOT_CONFIGURED)
  lastPublishedAt   DateTime?
  lastError         String?
  createdAt         DateTime      @default(now())
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  externalAccountId String?

  @@unique([workspaceId, platform])
  @@map("platform_accounts")
}

model Analytics {
  id               String      @id @default(cuid())
  contentItemId    String
  contentItem      ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  platform         Platform
  views            Int         @default(0)
  likes            Int         @default(0)
  comments         Int         @default(0)
  shares           Int         @default(0)
  saves            Int         @default(0)
  engagementRate   Float       @default(0)
  watchTimeSeconds Int         @default(0)
  ctr              Float?
  recordedAt       DateTime    @default(now())

  @@map("analytics")
}

model AgentRun {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentKey    String
  agentName   String
  task        String
  status      AgentStatus @default(IDLE)
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  result      String?
  error       String?

  @@map("agent_runs")
}

model IntegrationStatus {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String
  status        AccountStatus @default(NOT_CONFIGURED)
  lastCheckedAt DateTime      @default(now())
  lastError     String?

  @@unique([workspaceId, key])
  @@map("integration_status")
}

model Setting {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  value       String    @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@map("settings")
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  detail      String    @default("")
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

/// Vom Betreiber in der App hinterlegte Zugänge (verschlüsselt mit
/// TOKEN_ENCRYPTION_KEY). Umgebungsvariablen des Servers haben Vorrang.
model OperatorSecret {
  key         String   @id
  valueEnc    String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("operator_secrets")
}

// Einnahmen (Abschnitt "Revenue" — nicht Teil des ursprünglichen Master-Prompts,
// auf Nutzerwunsch ergänzt). Plattformen geben Einnahmen überwiegend NICHT über
// eine öffentliche API heraus (TikTok/Meta gar nicht, YouTube nur eingeschränkt
// über die YouTube-Analytics-API mit Partnerprogramm-Zugang). Einträge sind
// deshalb primär manuell erfasst (`origin: MANUAL`); `origin: YOUTUBE_API` ist
// für eine spätere echte Anbindung vorgesehen, aber noch nicht implementiert —
// siehe `lib/integrations/registry.ts` (Status bleibt NOT_CONFIGURED).
model RevenueEntry {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform    Platform?
  type        RevenueType   @default(OTHER)
  status      RevenueStatus @default(RECEIVED)
  origin      RevenueOrigin @default(MANUAL)
  source      String        @default("")
  amount      Float
  currency    String        @default("EUR")
  note        String        @default("")
  recordedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("revenue_entries")
}

// Posteingang (auf Nutzerwunsch ergänzt). Es gibt für keine Plattform eine
// echte OAuth-Verbindung in dieser App — Konversationen werden deshalb
// manuell simuliert/importiert statt live von den Plattformen abgerufen.
// Das MessageAgent-Antwortdraft-Feature funktioniert echt (KI oder
// Template-Fallback); das tatsächliche Senden an eine reale Plattform ist
// als Adapter vorbereitet, meldet aber ehrlich NOT_CONFIGURED, solange kein
// echter Zugang existiert — siehe `lib/agents/messageAgent.ts`.
model Conversation {
  id                String             @id @default(cuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          Platform
  participantName   String
  participantHandle String             @default("")
  status            ConversationStatus @default(OPEN)
  lastMessageAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  status         MessageStatus    @default(RECEIVED)
  error          String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  @@map("messages")
}

// Lizenzierung (auf Nutzerwunsch ergänzt). Es gibt in dieser App noch kein
// Kundenkonto-/Login-System — der Zugriffsschutz läuft deshalb bewusst
// einfach über ein unlink­bares Freischalt-Token pro Kauf statt über echte
// Nutzerkonten. Jeder erfolgreiche Stripe-Checkout erzeugt genau einen
// License-Datensatz; das zugehörige Token landet als Cookie im Browser des
// Käufers. Der Betreiber-Zugang läuft separat über OWNER_ACCESS_KEY (siehe
// middleware.ts) und braucht keinen License-Datensatz.
model License {
  id                      String        @id @default(cuid())
  unlockToken             String        @unique
  status                  LicenseStatus @default(PENDING)
  customerEmail           String        @default("")
  stripeCheckoutSessionId String        @unique
  stripeCustomerId        String        @default("")
  stripePaymentIntentId   String        @default("")
  amountTotal             Int           @default(0)
  currency                String        @default("eur")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@map("licenses")
}

// ---------------------------------------------------------------------------
// Anmeldung, Pakete, Kontingente, Zahlungen (Mehrkundenbetrieb)
// ---------------------------------------------------------------------------

/// Serverseitige Sitzung. Im Cookie steht nur ein Zufallstoken, in der
/// Datenbank nur dessen SHA-256 — ein Datenbank-Leak liefert keine gültigen Cookies.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Fester Zeitfenster-Zähler für Missbrauchsschutz (Anmeldung, Widget, Registrierung).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@map("rate_limits")
}

/// Gebuchtes Paket eines Workspaces. Wird ausschließlich durch verifizierte
/// Stripe-Webhooks verändert (oder durch Testdaten mit source=TEST).
model WorkspacePlan {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 String // "PRO" | "MAXI"
  /// NONE | PENDING | ACTIVE | PAST_DUE | CANCELED | REFUNDED | PAYMENT_FAILED
  status               String    @default("NONE")
  source               String    @default("STRIPE") // STRIPE | TEST
  billingMode          String    @default("payment") // payment | subscription (aus dem Stripe-Preis, nicht erfunden)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  activatedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  @@map("workspace_plans")
}

/// Serverseitig angelegte Checkout-Zuordnung. Der Webhook vertraut nur
/// dieser Zeile (nicht den Metadaten aus dem Browser), um Paket und Workspace
/// zu bestimmen.
model PlanCheckout {
  id             String    @id // Stripe Checkout Session ID
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  plan           String
  stripePriceId  String
  expectedAmount Int // kleinste Währungseinheit, vor Rabatt
  currency       String
  mode           String // payment | subscription
  status         String    @default("OPEN") // OPEN | COMPLETED | EXPIRED | FAILED
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
  @@map("plan_checkouts")
}

/// Kontingent-Verbrauch je Workspace, Kennzahl und Zeitraum (YYYY-MM, UTC).
model UsageCounter {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String
  period      String
  used        Int       @default(0)

  @@unique([workspaceId, metric, period])
  @@map("usage_counters")
}

/// Jede Stripe-Event-ID wird genau einmal verarbeitet (Wiederholungsschutz).
model StripeEvent {
  id          String   @id
  type        String
  account     String? // gesetzt bei Connect-Events
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

/// Zahlungen an den Betreiber (Paketumsätze). Getrennt von CustomerSale.
model OperatorPayment {
  id             String   @id @default(cuid())
  stripeObjectId String   @unique // pi_/in_/re_/cs_
  kind           String // PAYMENT | REFUND
  workspaceId    String?
  plan           String?
  amount         Int // kleinste Währungseinheit, brutto; Erstattungen positiv, kind=REFUND
  taxAmount      Int      @default(0) // enthaltene Umsatzsteuer (bei Zahlungen)
  currency       String
  status         String
  livemode       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("operator_payments")
}

// ---------------------------------------------------------------------------
// Eigene Geschäftseinnahmen der Kunden (getrennt von Paketumsätzen)
// ---------------------------------------------------------------------------

/// Verbundenes Stripe-Händlerkonto (Connect) — genau eines je Workspace.
model MerchantAccount {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stripeAccountId  String    @unique
  chargesEnabled   Boolean   @default(false)
  payoutsEnabled   Boolean   @default(false)
  detailsSubmitted Boolean   @default(false)
  requirementsDue  String    @default("[]") // JSON string[]
  defaultCurrency  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("merchant_accounts")
}

model MerchantProduct {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  amount      Int // kleinste Währungseinheit
  currency    String    @default("eur")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("merchant_products")
}

/// Ein tatsächlicher Verkauf eines Kunden. externalId ist je Workspace
/// eindeutig — derselbe Verkauf kann so nicht doppelt (direkt + Import) zählen.
model CustomerSale {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         String // SECRET58_CHECKOUT | IMPORT_CSV
  externalId     String // z. B. Stripe PaymentIntent pi_..., oder Bestellnummer des Shops
  productName    String    @default("")
  amount         Int
  refundedAmount Int       @default(0)
  currency       String
  status         String // PAID | PARTIALLY_REFUNDED | REFUNDED | PENDING | FAILED
  isTestData     Boolean   @default(false)
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, externalId])
  @@map("customer_sales")
}

// ---------------------------------------------------------------------------
// "Meine Webseite verbinden" — Widget-Einbindung
// ---------------------------------------------------------------------------

model WebsiteConnection {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin      String // https://example.com (Schema + Host, ohne Pfad)
  verifyToken String
  verifiedAt  DateTime?
  assistant   String    @default("CHAT") // nur freigegebene Assistenten, siehe src/lib/website.ts
  publicKey   String    @unique // öffentliche, widerrufbare Kennung — kein Geheimnis
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("website_connections")
}

/// Anbieterangaben des Kunden als Verkäufer (Impressum nach § 5 DDG, Links zu
/// eigenen AGB/Datenschutz/Widerruf). Pflegt ausschließlich der Kunde selbst;
/// ohne vollständige Angaben sind seine Angebotsseiten nicht erreichbar.
model SellerProfile {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  anbieter       String    @default("")
  firma          String    @default("")
  anschrift      String    @default("") // mehrzeilig
  email          String    @default("")
  telefon        String    @default("")
  ustId          String    @default("")
  register       String    @default("")
  aufsicht       String    @default("")
  verantwortlich String    @default("")
  agbUrl         String    @default("")
  datenschutzUrl String    @default("")
  widerrufUrl    String    @default("")
  updatedAt      DateTime  @updatedAt

  @@map("seller_profiles")
}

/// Über Composio verbundene Plattform-Konten (je Workspace und Toolkit genau
/// ein Eintrag). Zugangstoken liegen ausschließlich bei Composio; hier stehen
/// nur die Konto-Kennung, der Status und das Ergebnis des letzten Lesetests.
model ComposioConnection {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolkit            String
  /// NONE | PENDING | ACTIVE | FAILED | EXPIRED | DISCONNECTED
  status             String    @default("NONE")
  connectedAccountId String?
  pendingAccountId   String?
  stateHash          String?
  pendingExpiresAt   DateTime?
  accountLabel       String    @default("")
  lastReadTestAt     DateTime?
  lastReadTestOk     Boolean?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, toolkit])
  @@map("composio_connections")
}

/// Dauerhafter Versandauftrag für einen geplanten Beitrag (Worker:
/// scripts/publish-worker.ts). Status: QUEUED → RUNNING → SUCCEEDED | FAILED;
/// CANCELED wenn Termin/Freigabe sich geändert hat; UNKNOWN wenn ein Versand
/// unterbrochen wurde und unklar ist, ob die Plattform veröffentlicht hat —
/// solche Aufträge werden NIE automatisch wiederholt.
model PublishJob {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  status        String      @default("QUEUED")
  attempts      Int         @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  message       String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, scheduledFor])
  @@index([contentItemId])
  @@map("publish_jobs")
}

/// Terminfenster für Erstgespräche (Startseite der Zentrale). Der Betreiber
/// legt freie Termine an; Besucher fragen einen an; der Betreiber bestätigt
/// oder gibt ihn wieder frei. datum/uhrzeit wie in der Zentrale (Ortszeit
/// Europe/Berlin), startsAt für Sortierung und „nicht in der Vergangenheit“.
model WebsiteAppointment {
  id             String    @id @default(cuid())
  datum          String
  uhrzeit        String
  startsAt       DateTime
  notiz          String    @default("")
  /// FREI | ANGEFRAGT | BESTAETIGT
  status         String    @default("FREI")
  kundeName      String?
  kundeEmail     String?
  kundeNachricht String    @default("")
  angefragtAm    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, startsAt])
  @@map("website_appointments")
}

/// Fragen an den Webseiten-Chat (nur mit freigeschalteter KI), damit echte
/// Fragen im Betreiberbereich sichtbar sind.
model WebsiteChatEntry {
  id        String   @id @default(cuid())
  frage     String
  antwort   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("website_chat_entries")
}

/// Newsletter-Anmeldungen der Startseite mit Double-Opt-in. Einwilligung
/// (Zeitpunkt, Wortlaut) wird als Nachweis gespeichert; aktiv erst nach Klick
/// auf den Bestätigungslink. Tokens nur als Hash gespeichert.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  /// PENDING | ACTIVE | UNSUBSCRIBED
  status           String    @default("PENDING")
  confirmTokenHash String?   @unique
  confirmExpiresAt DateTime?
  unsubscribeHash  String    @unique
  consentText      String
  consentAt        DateTime
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  lastMailAt       DateTime?
  createdAt        DateTime  @default(now())

  @@map("newsletter_subscribers")
}

/// Vom Betreiber erzeugter Promocode: schaltet ein Paket dauerhaft frei (ohne
/// Stripe). Nur der Hash wird gespeichert; der Klartext erscheint einmal beim Anlegen.
model PromoCode {
  id          String            @id @default(cuid())
  codeHash    String            @unique
  /// letzte 4 Zeichen zur Wiedererkennung in der Liste
  hint        String
  plan        String // "PRO" | "MAXI"
  label       String            @default("")
  maxUses     Int               @default(1)
  usedCount   Int               @default(0)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime          @default(now())
  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  workspaceId String
  redeemedAt  DateTime  @default(now())

  @@unique([promoCodeId, workspaceId])
  @@map("promo_redemptions")
}

// ---------------------------------------------------------------------------
// Pilotstudio (interner Betreiberbereich /operator/pilotstudio).
// Alle Datensätze hängen an einem Arbeitsbereich (heute: der des Betreibers;
// später: der jeweilige Kunde unter /kundenanfragen). Demo-Fälle sind über
// isDemo getrennt. Nachfrage-Gespräche (PilotInterview) und Budgetangaben
// sind ausschließlich über /api/operator erreichbar.
model PilotInquiry {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isDemo            Boolean   @default(false)
  demoCaseNo        Int?
  /// Herkunft bei übernommenen Anfragen (z. B. website:<conversationId>), verhindert Doppelübernahme
  sourceRef         String?
  channel           String    @default("manuell")
  receivedAt        DateTime  @default(now())
  subject           String
  body              String
  senderName        String    @default("")
  senderContact     String    @default("")
  category          String    @default("unklar")
  assignee          String    @default("")
  /// NEU, ENTWURF, PRUEFUNG, FREIGEGEBEN, UEBERGEBEN, VERSAND_AUSSTEHEND, VERSENDET, VERSAND_FEHLGESCHLAGEN, ABGESCHLOSSEN
  status            String    @default("NEU")
  needsHuman        Boolean   @default(false)
  riskNote          String    @default("")
  draftText         String    @default("")
  draftVersion      Int       @default(0)
  /// DEMO (Musterantwort), KI, MANUELL
  draftSource       String    @default("")
  approvedVersion   Int?
  approvedTextHash  String?
  approvedById      String?
  approvedAt        DateTime?
  sendAttempts      Int       @default(0)
  sendKey           String?   @unique
  sentAt            DateTime?
  providerMessageId String?
  deliveredAt       DateTime?
  lastError         String    @default("")
  /// Testart: DEMO, KI, KANAL
  testMode          String    @default("DEMO")
  expected          String    @default("")
  autoCheck         String    @default("")
  manualMinutes     Float?
  pilotMinutes      Float?
  corrections       Int       @default(0)
  correctionKinds   String    @default("")
  /// OFFEN, BESTANDEN, NICHT_BESTANDEN
  testResult        String    @default("OFFEN")
  testReason        String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events PilotEvent[]

  @@unique([workspaceId, sourceRef])
  @@index([workspaceId, isDemo])
  @@map("pilot_inquiries")
}

model PilotEvent {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inquiryId   String?
  inquiry     PilotInquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  userId      String?
  actor       String        @default("")
  action      String
  detail      String        @default("")
  createdAt   DateTime      @default(now())

  @@index([workspaceId, inquiryId])
  @@map("pilot_events")
}

model PilotInterview {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slot              Int
  firmCode          String    @default("")
  industry          String    @default("")
  channels          String    @default("")
  inquiriesPerWeek  Float?
  minutesPerInquiry Float?
  topIssues         String    @default("")
  biggestEffort     String    @default("")
  humanDecisions    String    @default("")
  desiredOutcome    String    @default("")
  /// UNGEFRAGT, KEIN_INTERESSE, UNKLAR, WEITERES_GESPRAECH, PILOT_PRUEFEN
  interest          String    @default("UNGEFRAGT")
  budgetText        String    @default("")
  budgetCurrency    String    @default("")
  interviewDate     String    @default("")
  notes             String    @default("")
  nextStep          String    @default("")
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, slot])
  @@map("pilot_interviews")
}

model PilotConfig {
  workspaceId      String    @id
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledge        String    @default("")
  rules            String    @default("")
  responsibilities String    @default("")
  checklist        String    @default("{}")
  updatedAt        DateTime  @updatedAt

  @@map("pilot_configs")
}

/// Dateiaustausch: Dateien eines Kundenkontos (Inhalt getrennt in KundenDateiInhalt,
/// damit Listen keine Dateiinhalte laden). Gespeichert in der Datenbank, weil die
/// Festplatte des Servers ohne Zusatz-Disk bei jedem Neustart geleert wird.
model KundenDatei {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ordner        String
  name          String
  mime          String             @default("application/octet-stream")
  groesse       Int
  sha256        String
  /// KUNDE | BETREIBER | AGENT
  quelle        String             @default("KUNDE")
  quelleName    String             @default("")
  erstelltVonId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  inhalt        KundenDateiInhalt?
  freigaben     DateiFreigabe[]

  @@index([workspaceId, ordner])
  @@map("kunden_dateien")
}

model KundenDateiInhalt {
  dateiId String      @id
  datei   KundenDatei @relation(fields: [dateiId], references: [id], onDelete: Cascade)
  daten   Bytes

  @@map("kunden_datei_inhalte")
}

/// Freigabe-Link für eine Datei (z. B. an einen anderen Kunden). Gespeichert wird nur der Hash des Schlüssels.
model DateiFreigabe {
  id            String      @id @default(cuid())
  dateiId       String
  datei         KundenDatei @relation(fields: [dateiId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  ablauf        DateTime
  maxAbrufe     Int
  abrufe        Int         @default(0)
  widerrufenAm  DateTime?
  erstelltVonId String?
  createdAt     DateTime    @default(now())

  @@index([dateiId])
  @@map("datei_freigaben")
}

model KundenLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  titel       String
  url         String
  art         String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("kunden_links")
}
