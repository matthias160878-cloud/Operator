# --- KI-Research-Team (optional; ohne Schlüssel laufen die Agenten im Vorlagen-Modus) ---
ANTHROPIC_API_KEY=
# Lead Orchestrator
TRADING_MODEL=claude-fable-5-2
# Spezialisten-Agenten
TRADING_AGENT_MODEL=claude-fable-5-2
# low | medium | high | xhigh | max
TRADING_EFFORT=high

# --- Risiko (Prop-Firm-tauglich) ---
# 1 % Kontorisiko pro Trade
RISK_PER_TRADE=0.01
# Tagesverlustlimit (Anteil vom Tagesstartkapital)
DAILY_LOSS_LIMIT=0.04
# Gesamtverlustlimit (Anteil vom Startkapital)
TOTAL_LOSS_LIMIT=0.08
MAX_OPEN_POSITIONS=3
# Mindest-CRV 1:2
MIN_RR=2.0
ACCOUNT_BALANCE=10000

# --- Kosten im Backtest (Preis-Einheiten bzw. Anteil) ---
SPREAD=0.00008
SLIPPAGE=0.00002
COMMISSION_RATE=0.00003

# --- Ausführung ---
# paper | ccxt | mt5
BROKER=paper
# true erlaubt Echtgeld - jede Order braucht trotzdem "algo-trading approve"
LIVE_TRADING=false
ALLOWED_SYMBOLS=EURUSD,GBPUSD,XAUUSD,GER40,BTC/USDT
# Pflicht für den TradingView-Webhook
WEBHOOK_SECRET=
WEBHOOK_PORT=8765
JOURNAL_PATH=data/journal.db

# CCXT (nur Read+Trade, KEIN Withdraw, IP-beschränkt)
CCXT_EXCHANGE=phemex
CCXT_API_KEY=
CCXT_SECRET=

# MetaTrader 5 (nur Windows)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
